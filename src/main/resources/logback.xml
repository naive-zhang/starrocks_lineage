<?xml version="1.0" encoding="UTF-8"?>
<!--
  Runtime logging of the standalone jar (tests use logback-test.xml). INFO to stdout; the HTTP client is limited to
  WARN, otherwise its DEBUG wire log would print every Stream Load body. Override with -Dlogback.configurationFile=...
-->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="org.apache.hc" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="com.starrocks.lineage" level="INFO"/>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
